# Copy to .env and fill in. .env is git-ignored; never put real keys in this file.

# Composio Connect consumer key (dashboard -> AI Clients setup). Sent as x-consumer-api-key to the MCP endpoint.
COMPOSIO_CONSUMER_KEY=your_composio_consumer_key
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# OpenAI-compatible endpoint for the pipeline's model (Responses API).
OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
OPENAI_API_KEY=your_model_api_key

# Deployment names for the researcher and the critic.
APPSCOUT_MODEL=gpt-6-sol
APPSCOUT_CRITIC_MODEL=gpt-6-sol

# Tokens-per-minute quota of each deployment (Azure reports it in the x-ratelimit-limit-tokens response header).
# Requests are paced to stay under it. Deployments not listed are not paced.
APPSCOUT_TPM_LIMITS=gpt-6-sol=125000

# Optional second endpoint. Any NAME_BASE_URL / NAME_API_KEY pair can be selected per role with
# --researcher-endpoint NAME or --critic-endpoint NAME (or APPSCOUT_RESEARCHER_ENDPOINT / APPSCOUT_CRITIC_ENDPOINT).
# COMPOSER_BASE_URL=https://your-second-resource.services.ai.azure.com/openai/v1
# COMPOSER_API_KEY=your_second_model_api_key
